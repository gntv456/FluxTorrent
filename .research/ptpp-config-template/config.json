{
  "//": "PT-Plugin-Plus 站点收录模板（fork pt-plugins/PT-Plugin-Plus → resource/sites/<域名>/config.json → PR）。搜索走 /compat/nexusphp/torrents.json（JSON 结果，无需 DOM 解析）；下载链 download.php?id=&passkey=；用户面板走 ptppUserInfo 聚合端点。占位符 {{DOMAIN}} 提 PR 时替换为站点实际域名。",
  "version": "1.0.0",
  "schema": "NexusPHP",
  "host": "{{DOMAIN}}",
  "name": "FluxTorrent",
  "description": "FluxTorrent（教育垂直 PT）；schema 标 NexusPHP 仅为复用插件既有解析配置，实际为自研 Rust 架构，字段口径经 /api/v1/compat 层对齐。",
  "url": "https://{{DOMAIN}}/",
  "icon": "icon.png",
  "tags": ["教育", "综合"],
  "levelRequirements": [{ "level": 1, "name": "LV1 新芽", "interval": "P3D", "downloaded": 0, "ratio": 0, "seedingPoints": 0, "privilege": "注册即达" }],
  "collaborator": ["FluxTorrent 官方"],
  "searchEntryConfig": {
    "entry": "/api/v1/compat/nexusphp/torrents.json?keyword=$key$&pagesize=50",
    "resultType": "json",
    "resultSelector": "",
    "parseScriptFile": "fluxtorrent.js",
    "enable": true
  },
  "searchEntry": [{
    "name": "全部",
    "enabled": true
  }],
  "parser": {
    "downloadURL": "/api/v1/compat/nexusphp/download.php?id=$id$&passkey=$passkey$",
    "resultSelector": ""
  },
  "selectors": {
    "userBaseInfo": {
      "page": "/api/v1/plugins/ptppUserInfo",
      "fields": {
        "id": { "selector": ["data.id"], "attr": "text" },
        "name": { "selector": ["data.name"], "attr": "text" },
        "bonus": { "selector": ["data.bonus"], "attr": "text" },
        "uploaded": { "selector": ["data.uploaded"], "attr": "text" },
        "downloaded": { "selector": ["data.downloaded"], "attr": "text" },
        "seeding": { "selector": ["data.seeding"], "attr": "text" },
        "leeching": { "selector": ["data.leeching"], "attr": "text" },
        "seedingSize": { "selector": ["data.seedingSize"], "attr": "text" },
        "invites": { "selector": ["data.invites"], "attr": "text" },
        "levelName": { "selector": ["data.levelName"], "attr": "text" }
      }
    }
  },
  "supportedFeatures": {
    "imdb": false,
    "douban": false
  }
}
