# 装机闸门隔离栈（scripts/install_e2e.py 专用）：
# 独立项目名 + 容器名 + 端口 + 卷名，与站长日常栈零共享。
# 用完即 down -v，不残留。
DB_PASSWORD=e2e_gate_pw_32chars_minimum_ok!
REDIS_PASSWORD=e2e_gate_redis_pw_32chars_min!
JWT_SECRET=e2e_gate_jwt_secret_random_at_least_32bytes_xx
CORS_ORIGINS=http://localhost:13001
API_BIND=127.0.0.1
FLUX_PG_CONTAINER=flux-e2e-postgres
FLUX_REDIS_CONTAINER=flux-e2e-redis
FLUX_API_CONTAINER=flux-e2e-api
FLUX_DB_PORT=15433
FLUX_REDIS_PORT=16381
FLUX_API_PORT=18081
FLUX_PG_VOLUME=e2e_gate_pgdata
FLUX_REDIS_VOLUME=e2e_gate_redisdata
FLUX_ATTACH_VOLUME=e2e_gate_attachments
