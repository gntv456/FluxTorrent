# FluxTorrent 环境变量模板（方案 §8.4 集中配置）
# 注意：compose 的 project 目录是 docker/，请执行
#   cp docker/.env.example docker/.env && vim docker/.env
DB_PASSWORD=change_me_32_chars_minimum_password
REDIS_PASSWORD=change_me_redis_password
JWT_SECRET=change_me_random_at_least_32_bytes_secret
NEXT_PUBLIC_API_URL=http://localhost:8080
PUBLIC_TRACKER_URL=http://localhost:7070
# API 允许的跨域来源（逗号分隔，生产必填：https://你的域名）
# 本地测试默认放行 web 容器的来源；生产必须改成你自己的域名，留空会启动失败
CORS_ORIGINS=http://localhost:3000

# UDP tracker（可选，默认关闭）：私有站 passkey 随 HTTP announce URL path 传递（BEP3 天然
# 支持）；UDP 标准包不携带身份，仅对本站扩展约定（URL path 填入 tracker_id）的客户端可用。
# 需要时设为 udp://你的域名:6969 —— .torrent 会追加 UDP tier，客户端失败后按 BEP12 降级 HTTP。
#TRACKER_UDP_URL=udp://localhost:6969

# Prometheus 指标端点门禁（api 与 tracker 同一 token；留空 = /metrics 返回 404 隐藏）
#ANN_METRICS_TOKEN=

# 监控栈（docker compose --profile monitoring up -d 启用 prometheus+grafana，
# 预置仪表盘与五条最低告警；grafana 管理密码，启用 monitoring profile 时必填）
#GRAFANA_PASSWORD=

# 反代模式（可选）：api 部署在 Nginx/Pingora 等反代之后时设 1——限流/封禁/登录风控
# 改信 X-Forwarded-For 首值取真实客户端 IP（api 直连暴露时严禁开启，可被伪造绕过）
#TRUST_PROXY=1
# 反代层级深度（默认 1）：TRUST_PROXY=1 时从右往左数第 N 跳是本站反代，
# 多层 CDN/反代时按实际层数设，取错层会把 CDN 出口当客户端 IP
#TRUST_PROXY_DEPTH=1

# Web Push 通知（可选；浏览器推送。密钥对用 npx web-push generate-vapid-keys 生成，
# 公钥另需进后台设置 webpush_public）
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=

# 对外绝对地址（可选；影响 RSS 链接/邮件正文/Web Push 载荷里的绝对 URL 拼接。
# 不设时用请求 Host 推导）
#PUBLIC_SITE_URL=https://your-site.example
#PUBLIC_API_URL=https://your-site.example/api
#PUBLIC_SITE_NAME=Your Site Name

# 进阶开关（一般保持默认即可）
#PASSKEY_GRACE_HOURS=3        # 改密后旧 passkey 宽限（重置 passkey 无宽限即时撤销）
#ALLOW_PRIVATE_PEER_IP=0      # 调试：允许 peer 汇报私网 IP（生产勿开）
#FLUX_DEV=0                   # 开发模式（日志着色等）
#DATABASE_REPLICA_URL=        # 只读副本 DSN；空 = 读写同库
#FLUX_TRACKER_BIND=0.0.0.0:7070

# tracker announce/scrape 调优（默认值见 apps/tracker/src；一般不动）
#ANN_BLACK_PORTS=             # 逗号分隔封禁端口（如 25,445 的 SMB 直连探测）
#ANN_EVENT_MERGE_PCT=40       # 同(账号,种子)周期事件合并窗（interval 百分比，clamp 60-900s）
#ANN_INTERVAL_JITTER_PCT=10   # announce 间隔抖动百分比（防客户端同步风暴）
#FLUX_TRACKER_PIECE_PROBE=1   # BT 三阶段探测（握手/bitfield/piece SHA-1）
#SCR_RATE_IP_PER_MIN=60       # scrape 每 IP 每分钟限额
#SCR_MAX_HASHES=80            # 单次 scrape 最大 hash 数
#TRACKER_UDP_WORKERS=2        # UDP worker 数（0 = 关闭 UDP）

# 邮件（密码重置/群发；生产未配置时密码重置拒绝服务，不会把重置 token 打进日志）
#SMTP_URL=smtps://user:pass@smtp.example.com:465
#SMTP_FROM=no-reply@your-site.example

# 附件对象存储（可选，默认本地卷）：后台设置 storage_backend=s3 后生效。
# S3 兼容端点全适用（MinIO 自建 / 阿里云 OSS / 腾讯云 COS / Cloudflare R2 / B2）。
# 对象键 = sha 两级分片（与本地卷同构），迁移 = rsync 本地卷进 bucket 后切换开关，
# 读取端自动双后端回落，切换期间新旧附件都能读。
#S3_ENDPOINT=https://s3.example.com
#S3_BUCKET=fluxtorrent-attachments
#S3_KEY=AKID...
#S3_SECRET=...
#S3_REGION=us-east-1

# 端口绑定（默认仅本机，经反代对外）
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# 镜像来源（预构建镜像升级路径；fork 站长可改成自己的 registry/版本）
# 默认：ghcr.io/gntv456/fluxtorrent/{api,worker,tracker,web}:latest
# 升级：docker compose pull && docker compose up -d（无需本机 Rust/Node 工具链）
#FLUX_IMAGE_PREFIX=ghcr.io/gntv456/fluxtorrent
#FLUX_VERSION=latest

# ---------------------------------------------------------------------------
# 多套部署（同一宿主同时跑第二套站点）
# 默认 container_name / 宿主端口 / 卷名都是固定的：flux-* / 5432·6379·8080·
# 3000·7070·6969 / docker_*。直接起第二套会整排撞名。把下列键写进第二套的
# env 文件（如 docker/.env.b）后启动即可，键不设就与单套部署完全一致：
#   docker compose --env-file docker/.env.b -p fluxtorrent-b up -d
# 最少要改的是容器名与端口（卷名不改会与第一套共库共附件）：
#FLUX_PG_CONTAINER=flux-postgres-b
#FLUX_REDIS_CONTAINER=flux-redis-b
#FLUX_API_CONTAINER=flux-api-b
#FLUX_WORKER_CONTAINER=flux-worker-b
#FLUX_TRACKER_CONTAINER=flux-tracker-b
#FLUX_WEB_CONTAINER=flux-web-b
#FLUX_PROM_CONTAINER=flux-prometheus-b
#FLUX_GRAFANA_CONTAINER=flux-grafana-b
#FLUX_DB_PORT=5433
#FLUX_REDIS_PORT=6380
#FLUX_API_PORT=8081
#FLUX_WEB_PORT=3001
#FLUX_TRACKER_PORT=7071
#FLUX_TRACKER_UDP_PORT=6970
#FLUX_PROM_PORT=9091
#FLUX_GRAFANA_PORT=3002
#FLUX_PG_VOLUME=docker_pgdata_b
#FLUX_REDIS_VOLUME=docker_redisdata_b
#FLUX_ATTACH_VOLUME=docker_attachments_b
#FLUX_PROM_VOLUME=docker_prometheus-data_b
#FLUX_GRAFANA_VOLUME=docker_grafana-data_b
# 备份目录默认 ../backups 两套共用，第二套建议单独指一个目录：
#FLUX_BACKUP_DIR=../backups-b
